# ======================= UNCLONE backend settings =======================
# Copy to .env and fill in. Every option is documented in app/config.py.

STAFF_API_KEY=change-me-staff-key          # fraud desk / admin (header X-Staff-Key)
AUDIT_HMAC_SECRET=change-me-long-random     # signs audit log + evidence reports
CORS_ORIGINS=*                              # your frontend origin, e.g. http://localhost:5173
PORT=8000
BANK_ORIGIN=http://localhost:8000
WEBAUTHN_RP_ID=localhost
APP_ENV=dev

# ---------- Free AI providers ----------
# One free Groq key (https://console.groq.com/keys) powers BOTH speech-to-text and the LLM.
GROQ_API_KEY=
LLM_PROVIDER=groq                 # groq | openai | anthropic | gemini | none
LLM_MODEL=                        # blank = provider default (groq: qwen/qwen3.8-27b, auto-falls back to gpt-oss)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

GROQ_API_KEY=
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=
SARVAM_AI_API=

STT_PROVIDER=sarvam               # sarvam | groq | local
STT_FALLBACK=groq                 # groq | local faster-whisper (GPU/CPU)
LOCAL_WHISPER_MODEL=small         # small = good on GPU/CPU; base = faster

TTS_PROVIDER=sarvam               # sarvam | edge | none
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_KN=kn-IN-SapnaNeural

# ---------- Voice security engines ----------
DEVICE=auto                          # auto | cuda | cpu (auto uses NVIDIA GPU like RTX 4060 if present)
VOICE_PRIMARY=detectifai          # detectifai | local | mock
VOICE_FALLBACK=local              # local | mock | none

# ---------- DetectifAI (fill on day 1 from their docs, then run scripts/check_detectifai.py) ----------
DETECTIFAI_BASE_URL=
DETECTIFAI_API_KEY=
DETECTIFAI_AUTH_HEADER=Authorization
DETECTIFAI_AUTH_SCHEME=Bearer      # blank = send the raw key
DETECTIFAI_UPLOAD_MODE=multipart   # multipart | base64_json
DETECTIFAI_AUDIO_FIELD=file
DETECTIFAI_SPEAKER_FIELD=speaker_id
DETECTIFAI_REFERENCE_FIELD=reference
DETECTIFAI_VERIFY_MODE=enrolled_id # enrolled_id (enroll once, verify by id) | pair (send reference + test audio)
DETECTIFAI_ENROLL_PATH=/v1/speaker/enroll
DETECTIFAI_VERIFY_PATH=/v1/speaker/verify
DETECTIFAI_DEEPFAKE_PATH=/v1/deepfake/detect
DETECTIFAI_ENROLL_ID_PATH=speaker_id
DETECTIFAI_VERIFY_SCORE_PATH=score          # dotted path in the JSON response, e.g. data.similarity
DETECTIFAI_VERIFY_SCORE_MAX=1.0             # 100 if they return percentages
DETECTIFAI_DEEPFAKE_SCORE_PATH=fake_probability
DETECTIFAI_DEEPFAKE_SCORE_IS_REAL=false     # true if the score means "probability REAL"
DETECTIFAI_DEEPFAKE_SCORE_MAX=1.0
DETECTIFAI_EXTRA_JSON=                      # e.g. {"model":"v2"} added to every request

# ---------- Policy thresholds (defaults are sensible; tune on day 1) ----------
TRUST_ALLOW=0.72
TRUST_STEPUP=0.45
SPEAKER_REJECT=0.30
SYNTHETIC_HARD=0.80
SYNTHETIC_SOFT=0.55
CHALLENGE_SLOW_LATENCY_S=4.0
LOCAL_SPOOF_THRESHOLD=0.5          # use POST /api/admin/calibrate-spoof at the venue
